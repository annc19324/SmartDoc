# Environment configuration for SmartDoc Backend
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Neon PostgreSQL with pgvector)
# Example: postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/smartdoc?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/smartdoc?schema=public"

# Authentication
JWT_SECRET=super_secret_smartdoc_access_token_jwt_key_2026
JWT_REFRESH_SECRET=super_secret_smartdoc_refresh_token_jwt_key_2026
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
