datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum DocumentStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

enum QuizDifficulty {
  EASY
  MEDIUM
  HARD
}

enum SummaryType {
  SHORT
  DETAILED
  KEY_POINTS
  IMPORTANT_TERMS
  EXAM_REVIEW
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password       String
  fullName       String
  avatar         String?
  role           Role            @default(STUDENT)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  refreshTokens  RefreshToken[]
  documents      Document[]      @relation("UploadedDocuments")
  coursesCreated Course[]        @relation("TeacherCourses")
  chatSessions   ChatSession[]
  summaries      Summary[]
  quizzesCreated Quiz[]          @relation("TeacherQuizzes")
  quizAttempts   QuizAttempt[]
  flashcardDecks FlashcardDeck[]
  mindmaps       Mindmap[]
  studyPlans     StudyPlan[]
  studyProgress  StudyProgress[]
  analytics      LearningAnalytics?
  ratings        Rating[]
  comments       Comment[]
  notifications  Notification[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  documents   Document[]
  courses     Course[]

  @@map("categories")
}

model Course {
  id          String     @id @default(uuid())
  title       String
  description String?
  code        String     @unique
  thumbnail   String?
  teacherId   String
  teacher     User       @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  documents   Document[]
  quizzes     Quiz[]

  @@index([teacherId])
  @@index([categoryId])
  @@map("courses")
}

model Document {
  id            String          @id @default(uuid())
  title         String
  description   String?
  fileUrl       String
  publicId      String?
  fileType      String
  fileSize      Int
  thumbnail     String?
  pageCount     Int             @default(0)
  status        DocumentStatus  @default(UPLOADING)
  errorMessage  String?
  viewCount     Int             @default(0)
  downloadCount Int             @default(0)

  courseId      String?
  course        Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  uploadedById  String
  uploadedBy    User            @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  chunks        DocumentChunk[]
  chatSessions  ChatSession[]
  summaries     Summary[]
  quizzes       Quiz[]
  flashcardDecks FlashcardDeck[]
  mindmaps      Mindmap[]
  studyProgress StudyProgress[]
  ratings       Rating[]
  comments      Comment[]

  @@index([uploadedById])
  @@index([courseId])
  @@index([categoryId])
  @@index([status])
  @@map("documents")
}

model DocumentChunk {
  id         String                 @id @default(uuid())
  documentId String
  document   Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String                 @db.Text
  pageNumber Int                    @default(1)
  chunkIndex Int                    @default(0)
  embedding  Unsupported("vector(768)")?
  metadata   Json?
  createdAt  DateTime               @default(now())

  @@index([documentId])
  @@index([pageNumber])
  @@map("document_chunks")
}

model ChatSession {
  id         String        @id @default(uuid())
  title      String
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String?
  document   Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  messages   ChatMessage[]

  @@index([userId])
  @@index([documentId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // "user" or "assistant"
  content   String      @db.Text
  sources   Json?       // [{ documentId, documentName, pageNumber, contentSnippet }]
  createdAt DateTime    @default(now())

  @@index([sessionId])
  @@map("chat_messages")
}

model Summary {
  id             String      @id @default(uuid())
  documentId     String
  document       Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           SummaryType @default(DETAILED)
  content        String      @db.Text
  keyPoints      Json?       // string[]
  importantTerms Json?       // [{ term, definition }]
  createdAt      DateTime    @default(now())

  @@index([documentId])
  @@index([userId])
  @@map("summaries")
}

model Quiz {
  id          String         @id @default(uuid())
  title       String
  description String?
  difficulty  QuizDifficulty @default(MEDIUM)
  documentId  String?
  document    Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  courseId    String?
  course      Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User           @relation("TeacherQuizzes", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  questions   QuizQuestion[]
  attempts    QuizAttempt[]

  @@index([documentId])
  @@index([courseId])
  @@index([createdById])
  @@map("quizzes")
}

model QuizQuestion {
  id            String   @id @default(uuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question      String   @db.Text
  options       Json     // string[] (4 options)
  correctAnswer Int      // 0, 1, 2, 3
  explanation   String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id             String    @id @default(uuid())
  quizId         String
  quiz           Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  score          Float     // e.g. 8.5
  totalQuestions Int
  correctAnswers Int
  answers        Json      // Record<string, number> (questionId -> selectedOption)
  completedAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@index([quizId])
  @@index([userId])
  @@map("quiz_attempts")
}

model FlashcardDeck {
  id          String      @id @default(uuid())
  title       String
  description String?
  documentId  String?
  document    Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  cards       Flashcard[]

  @@index([documentId])
  @@index([userId])
  @@map("flashcard_decks")
}

model Flashcard {
  id        String        @id @default(uuid())
  deckId    String
  deck      FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front     String        @db.Text
  back      String        @db.Text
  order     Int           @default(0)
  isMastered Boolean      @default(false)
  createdAt DateTime      @default(now())

  @@index([deckId])
  @@map("flashcards")
}

model Mindmap {
  id         String   @id @default(uuid())
  title      String
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  treeData   Json     // Hierarchical node structure: { id, label, children, ... }
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([documentId])
  @@index([userId])
  @@map("mindmaps")
}

model StudyPlan {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject              String
  examDate             DateTime
  targetScore          String
  availableHoursPerDay Float
  currentLevel         String
  planData             Json     // Array of days/milestones: [{ day, topic, tasks: [], completed: false }]
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@map("study_plans")
}

model StudyProgress {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  progressPercent Float    @default(0)
  lastPage        Int      @default(1)
  completed       Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@unique([userId, documentId])
  @@map("study_progress")
}

model LearningAnalytics {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalStudyMinutes   Int      @default(0)
  quizzesTaken        Int      @default(0)
  averageQuizScore    Float    @default(0)
  flashcardsReviewed  Int      @default(0)
  documentsViewed     Int      @default(0)
  strongTopics        Json?    // string[]
  weakTopics          Json?    // string[]
  aiRecommendation    String?  @db.Text
  updatedAt           DateTime @updatedAt

  @@map("learning_analytics")
}

model Rating {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score      Int      // 1 to 5
  review     String?  @db.Text
  createdAt  DateTime @default(now())

  @@unique([userId, documentId])
  @@map("ratings")
}

model Comment {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([userId])
  @@map("comments")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, AI_READY
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}
